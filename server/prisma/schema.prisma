// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Model untuk komoditas (misalnya: Beras Medium, Gula Pasir)
model Commodity {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  unit        String   // KG, LITER, dll
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  prices      Price[]
}

// Model untuk harga komoditas historis (Time-Series)
model Price {
  id          String    @id @default(uuid())
  commodityId String
  commodity   Commodity @relation(fields: [commodityId], references: [id])
  price       Float
  date        DateTime  @default(now())
  market      String    @default("Rata-rata Jawa Tengah") // Bisa spesifik per pasar/kabupaten
  status      String    @default("VALID")
  source      String    @default("Petugas Lapangan")
  createdAt   DateTime  @default(now())

  @@index([commodityId, date])
}

// Model untuk Admin / Pengguna Sistem
model User {
  id                   String         @id @default(uuid())
  email                String         @unique
  name                 String?
  password             String
  role                 Role           @default(VIEWER)
  status               String         @default("ACTIVE")
  lastLogin            DateTime?
  fieldReports         FieldReport[]  @relation("FieldReportReporter")
  reviewedFieldReports FieldReport[]  @relation("FieldReportReviewer")
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

enum Role {
  ADMIN
  EDITOR
  PETUGAS
  VIEWER
}

enum FieldReportStatus {
  SUBMITTED
  REVIEWED
  APPROVED
  REJECTED
}

// Laporan tugas lapangan yang dikirim petugas dengan koordinat GPS
model FieldReport {
  id             String             @id @default(uuid())
  reporterId     String?
  reporter       User?              @relation("FieldReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  petugasCode    String
  petugasName    String
  petugasEmail   String?
  commoditySlug  String
  commodityName  String
  market         String
  price          Float
  reportDate     DateTime
  latitude       Float
  longitude      Float
  accuracy       Float?
  locationLabel  String
  notes          String?
  photoUrl       String?
  status         FieldReportStatus @default(SUBMITTED)
  reviewedById   String?
  reviewedByUser User?             @relation("FieldReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([petugasCode, reportDate])
  @@index([status, createdAt])
}
