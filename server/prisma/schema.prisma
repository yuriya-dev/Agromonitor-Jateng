generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Commodity {
  id           String        @id @default(uuid())
  slug         String        @unique
  name         String
  unit         String
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  prices       Price[]
  fieldReports FieldReport[]
  priceAlerts  PriceAlert[]
}

model Price {
  id               String          @id @default(uuid())
  commodityId      String
  price            Float
  date             DateTime        @default(now())
  market           String          @default("Rata-rata Jawa Tengah")
  status           String          @default("VALID")
  source           String          @default("Petugas Lapangan")
  createdAt        DateTime        @default(now())
  commodity        Commodity       @relation(fields: [commodityId], references: [id])
  aggregationRunId String?
  aggregationRun   AggregationRun? @relation(fields: [aggregationRunId], references: [id])

  @@index([commodityId, date])
}

model User {
  id                   String        @id @default(uuid())
  email                String        @unique
  name                 String?
  password             String        @default("public")
  role                 Role          @default(VIEWER)
  status               String        @default("ACTIVE")
  lastLogin            DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  notifyDaily          Boolean       @default(false)
  preferences          String?
  whatsapp             String?
  fieldReports         FieldReport[] @relation("FieldReportReporter")
  reviewedFieldReports FieldReport[] @relation("FieldReportReviewer")
  priceAlerts          PriceAlert[]
}

model FieldReport {
  id             String            @id @default(uuid())
  reporterId     String?
  petugasCode    String
  petugasName    String
  petugasEmail   String?
  commoditySlug  String
  commodityName  String
  market         String
  price          Float
  reportDate     DateTime
  latitude       Float
  longitude      Float
  accuracy       Float?
  locationLabel  String
  notes          String?
  photoUrl       String?
  status         FieldReportStatus @default(SUBMITTED)
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  reporter       User?             @relation("FieldReportReporter", fields: [reporterId], references: [id])
  reviewedByUser User?             @relation("FieldReportReviewer", fields: [reviewedById], references: [id])
  commodity      Commodity         @relation(fields: [commoditySlug], references: [slug])
  aggregationRunId String?
  aggregationRun   AggregationRun? @relation(fields: [aggregationRunId], references: [id])

  @@index([petugasCode, reportDate])
  @@index([status, createdAt])
}

model AggregationRun {
  id           String        @id @default(uuid())
  runAt        DateTime      @default(now())
  scanned      Int
  groups       Int
  created      Int
  skipped      Int
  details      Json?
  createdAt    DateTime      @default(now())
  prices       Price[]
  fieldReports FieldReport[]
}

enum Role {
  ADMIN
  EDITOR
  PETUGAS
  VIEWER
}

enum FieldReportStatus {
  SUBMITTED
  REVIEWED
  APPROVED
  REJECTED
}

model PriceAlert {
  id            String   @id @default(uuid())
  userId        String
  commoditySlug String
  condition     String   // "above" | "below"
  targetPrice   Float
  currentPrice  Float
  isTriggered   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  commodity     Commodity @relation(fields: [commoditySlug], references: [slug], onDelete: Cascade)

  @@index([userId])
  @@index([commoditySlug, isTriggered])
}
